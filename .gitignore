# data scripts

public/listing-pics
.swarm/memory.db
.swarm
.agents
CLAUDE.md
sync-scripts
scripts
today.md

# Claude Code local state (worktrees, memory, logs)
.claude/
.claude-flow/
# Agent tooling writes credentials straight into these — never commit them
claude-flow.config.json
*.local.json

# Codex local state
.codex

# MCP server dependencies
mcp/node_modules/
# MCP knowledge base (mcp/knowledge/) is COMMITTED so every machine and coding
# agent shares the same repo knowledge. Regenerate with
# `node mcp/scripts/generate-knowledge.mjs` and commit alongside code changes;
# CI (update-knowledge.yml) auto-commits any drift on staging/main.
# Only the local agent-swarm runtime log stays machine-local:
mcp/knowledge/agent-sessions.json
# Allow mcp/scripts/ even though root-level `scripts` is ignored
!mcp/scripts/
!mcp/scripts/**

# .mcp.json is committed so the team shares MCP server setup. It contains no
# secrets — the Supabase access token is env-interpolated (${SUPABASE_ACCESS_TOKEN}).

# Local documentation — not version controlled
docs/
# CI impact-check artifacts (generated)
ci-out/

# Firecrawl scrape output (research artifacts, not source)
.firecrawl/

# ── SEO engine (must stay at end of file: re-includes must follow excludes) ──
# Validator + benchmark allowlist are shared tooling; the seo-draft skill and
# content-draft docs travel with the repo. Weekly review sheets stay local.
!scripts/
scripts/*
!scripts/seo-engine/
scripts/seo-engine/reports/*.md
!.claude/
.claude/*
!.claude/skills/
!docs/
docs/*
!docs/content-drafts/
