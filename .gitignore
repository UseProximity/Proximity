# Claude Code local state (worktrees, memory, logs) — but the proximity-tutor
# skill is part of the product and stays versioned
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/proximity-tutor/
.claude-flow/

# Codex local state
.codex

# MCP server dependencies
mcp/node_modules/
# MCP knowledge base (mcp/knowledge/) is COMMITTED so every machine and coding
# agent shares the same repo knowledge. Regenerate with
# `node mcp/scripts/generate-knowledge.mjs` and commit alongside code changes;
# CI (update-knowledge.yml) auto-commits any drift on staging/main.
# Only the local agent-swarm runtime log stays machine-local:
mcp/knowledge/agent-sessions.json
# Allow mcp/scripts/ even though root-level `scripts` is ignored
!mcp/scripts/
!mcp/scripts/**

# .mcp.json is committed so the team shares MCP server setup. It contains no
# secrets — the Supabase access token is env-interpolated (${SUPABASE_ACCESS_TOKEN}).

# Local documentation — not version controlled
docs/
# CI impact-check artifacts (generated)
ci-out/
