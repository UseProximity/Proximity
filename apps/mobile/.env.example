# Base URL of the Next.js API (staging Vercel deployment during development)
EXPO_PUBLIC_API_URL=

# Mapbox token for @rnmapbox/maps (Phase 3)
EXPO_PUBLIC_MAPBOX_TOKEN=

# Optional, non-production only: an inbox to actually receive verification/
# reset emails while testing signup/login against a local or staging API
# (mirrors web's "📧 Test emails →" picker — mobile has no cookies, so this
# is sent as a header instead). Leave unset to have test emails suppressed.
EXPO_PUBLIC_TEST_EMAIL_TO=

# Per-platform Google OAuth client IDs (expo-auth-session requires one per
# platform, not a single shared client ID). Android is configured; iOS is
# still pending real per-platform setup in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
